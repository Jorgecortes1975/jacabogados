# Motor Disparador — Environment Variables
# Copy to .env and fill with actual credentials
# NEVER commit .env to version control

# ════════════════════════════════════════════════════════════════
# INTEGRACIONES EXTERNAS
# ════════════════════════════════════════════════════════════════

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://jacabogados.co/webhook/telegram
TELEGRAM_CHAT_ID=

# WhatsApp Business API
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_URL=https://jacabogados.co/webhook/whatsapp

# Email (Gmail/Office365)
EMAIL_ADDRESS=consultas@jacabogados.co
EMAIL_PASSWORD=
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# API REST
API_PORT=3001
API_KEY_HEADER=X-API-Key

# ════════════════════════════════════════════════════════════════
# FUENTES JURÍDICAS
# ════════════════════════════════════════════════════════════════

# LexisNexis Colombia
LEXISNEXIS_API_KEY=
LEXISNEXIS_API_URL=https://api.lexisnexis.com/v1

# Legal Data Hunter
LEGAL_DATA_HUNTER_API_KEY=
LEGAL_DATA_HUNTER_API_URL=https://api.legaldatahunter.com

# ════════════════════════════════════════════════════════════════
# VALIDACIÓN JAC
# ════════════════════════════════════════════════════════════════

JORGE_CORTES_EMAIL=jorge@jacabogados.co
JAC_VALIDATION_LEVEL_1=true
JAC_VALIDATION_LEVEL_2=true
JAC_VALIDATION_LEVEL_3=true

# ════════════════════════════════════════════════════════════════
# OPERACIÓN
# ════════════════════════════════════════════════════════════════

NODE_ENV=production
LOG_LEVEL=info
LOG_RETENTION_DAYS=90
ENABLE_METRICS=true
ENABLE_AUDIT_TRAIL=true

# ════════════════════════════════════════════════════════════════
# INSTRUCCIONES
# ════════════════════════════════════════════════════════════════
# 1. cp .env.example .env
# 2. Llenar valores de .env con credenciales reales
# 3. chmod 600 .env (solo lectura para el usuario)
# 4. Nunca hacer commit de .env
# 5. En producción, usar secrets management (AWS Secrets Manager, etc)
