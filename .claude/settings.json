{
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "Bash(pip3:*)",
      "Bash(pip:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/user/jacabogados && if [ -f generar_crm.py ] && echo \"$CLAUDE_TOOL_OUTPUT\" | grep -q 'generar_crm'; then echo '[hook] CRM script detectado - verifica crm_jaabogados.xlsx'; fi"
          }
        ]
      }
    ]
  }
}
