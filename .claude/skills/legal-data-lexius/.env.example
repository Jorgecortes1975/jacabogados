# CONFIGURACIÓN SEGURA — CONSULTOR LEGAL LEXIUS
# COPIA ESTE ARCHIVO A .env EN TU MÁQUINA LOCAL
# NUNCA COMMITS .env A GIT — SOLO .env.example

# Credenciales de Acceso Appcolombia.lexius.io
LEXIUS_USER=abogadojr@aliado.co
LEXIUS_PASS=Abogado2022*
LEXIUS_BASE_URL=https://appcolombia.lexius.io

# Configuración del Skill
LEXIUS_CACHE_DIR=/home/user/jacabogados/lexius-cache
LEXIUS_CACHE_VALIDITY_DAYS=30
LEXIUS_AUTO_UPDATE_INTERVAL_DAYS=60

# Logging (sin exponer credenciales)
LEXIUS_LOG_LEVEL=INFO
LEXIUS_LOG_FILE=/home/user/jacabogados/.logs/lexius-skill.log

# Notificaciones
LEXIUS_NOTIFY_LAWYER_EMAIL=jorgeacortesc38@gmail.com
LEXIUS_NOTIFY_ON_ERROR=true

# Integración con otros skills
LEXIUS_AUTO_INTEGRATE_ANALISIS_CASO=true
LEXIUS_AUTO_INTEGRATE_REDACCION=true
LEXIUS_AUTO_VALIDATE_ANTI_HALLUCINATION=true
