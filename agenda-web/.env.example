# Copie este archivo como .env y complete los valores. Nunca suba .env al repositorio.

# 1 = modo de prueba (sin cobrar ni tocar su calendario). Para producción use 0.
MODO_PRUEBA=1

# Dirección pública de la página (sin barra final). Ej.: https://www.jacabogados.com
SITIO_URL=http://localhost:3000

# Consulta (valores provisionales hasta que usted defina nombre y precio)
CONSULTA_NOMBRE=Consulta jurídica inicial
CONSULTA_PRECIO_COP=150000

# Festivos bloqueados, separados por coma, formato AAAA-MM-DD
FESTIVOS=

# Wompi (solo con MODO_PRUEBA=0). Para pruebas use https://sandbox.wompi.co/v1
WOMPI_API_URL=https://production.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=

# Google Calendar (solo con MODO_PRUEBA=0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
