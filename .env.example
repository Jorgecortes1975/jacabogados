# ====================================================
# LEXA-JAC v2.0 - Variables de Entorno
# ====================================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env
# 2. Reemplaza los valores con tus datos reales
# 3. NO commits .env a Git (está en .gitignore)
# ====================================================

# === ENTORNO ===
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TIMEZONE=America/Bogota

# === URLs ===
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
CALLBACK_URL=http://localhost:3000/auth/callback

# === BASE DE DATOS ===
# PostgreSQL (recomendado)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jacabogados
DB_USER=postgres
DB_PASSWORD=tu_contraseña_segura_aqui

# Alternativa: MongoDB (para auditoría)
MONGODB_URI=mongodb://localhost:27017/jacabogados_audit

# === KEYS DE API EXTERNA ===

# Legal Data Hunter (38M+ documentos jurídicos)
LEGAL_DATA_HUNTER_API_KEY=tu_api_key_aqui
LEGAL_DATA_HUNTER_SECRET=tu_secret_aqui

# DIAN - Dirección de Impuestos y Aduanas Nacionales
DIAN_API_KEY=tu_api_key_dian
DIAN_API_SECRET=tu_api_secret_dian
DIAN_CLIENT_ID=tu_client_id_dian

# === INTEGRACIÓN TELEGRAM ===
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui
TELEGRAM_WEBHOOK_URL=http://localhost:3000/webhook/telegram

# === INTEGRACIÓN EMAIL ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_contraseña_app_gmail

# Dirección de respuesta automática
MAIL_FROM=noreply@jacabogados.com
MAIL_FROM_NAME=JAC Abogados Asociados

# === INTEGRACIÓN GOOGLE (OAuth) ===
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# === SEGURIDAD ===
JWT_SECRET=tu_jwt_secret_super_seguro_aqui
JWT_EXPIRE=24h

# Encriptación
ENCRYPTION_KEY=tu_encryption_key_32_caracteres
ENCRYPTION_ALGORITHM=aes-256-cbc

# CORS permitido
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://jacabogados.com

# === AGENTES ===

# Agente Jurídico
AGENTE_JURIDICO_ENABLED=true
AGENTE_JURIDICO_TIMEOUT=300000
AGENTE_JURIDICO_MAX_RETRIES=3

# Agente Mercantil
AGENTE_MERCANTIL_ENABLED=true
AGENTE_MERCANTIL_TIMEOUT=300000

# Agente Tributario
AGENTE_TRIBUTARIO_ENABLED=true
AGENTE_TRIBUTARIO_DIAN_API_ENABLED=true

# Agente Ambiental
AGENTE_AMBIENTAL_ENABLED=true
AGENTE_AMBIENTAL_LICENCIA_TIMEOUT=600000

# Agente Laboral
AGENTE_LABORAL_ENABLED=true
AGENTE_LABORAL_JURISPRUDENCIA_ENABLED=true

# Agente Email
AGENTE_EMAIL_ENABLED=true
AGENTE_EMAIL_TEMPLATE_PATH=./templates/email

# === ALMACENAMIENTO ===
STORAGE_TYPE=local
STORAGE_PATH=./storage/uploads

# Alternativa: S3 (AWS)
# STORAGE_TYPE=s3
# AWS_S3_BUCKET=tu_bucket_name
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=tu_access_key
# AWS_SECRET_ACCESS_KEY=tu_secret_key

# === VALIDACIÓN JAC ===
JAC_VALIDATION_REQUIRED=true
JAC_VALIDATION_MULTIPLE_SOURCES=true
JAC_VALIDATION_TIMEOUT=180000
JAC_OWNER_EMAIL=jorgeacortesc38@gmail.com

# === LOGGING Y MONITORING ===
LOG_FORMAT=json
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14

# Sentry (error tracking)
SENTRY_DSN=https://tu_sentry_dsn@sentry.io/project_id
SENTRY_ENVIRONMENT=development

# === REDIS (Cache) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600

# === RABBITMQ (Colas de mensajes) ===
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFETCH=10

# === TERCEROS ===

# Stripe (Pagos - futuro)
STRIPE_PUBLIC_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_

# SendGrid (Email - alternativa)
SENDGRID_API_KEY=tu_sendgrid_api_key

# Twilio (SMS - futuro)
TWILIO_ACCOUNT_SID=tu_account_sid
TWILIO_AUTH_TOKEN=tu_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# === DESARROLLO ===
DEBUG=lexa:*
DEBUG_LEVEL=verbose

# Mock de servicios externos
USE_MOCK_SERVICES=false
MOCK_DIAN_RESPONSES=false
MOCK_LDH_RESPONSES=false

# === TESTING ===
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/jacabogados_test
TEST_NODE_ENV=test
TEST_TIMEOUT=10000

# ====================================================
# NOTAS IMPORTANTES:
# ====================================================
# 1. NUNCA commits este archivo modificado a Git
# 2. Mantenlo fuera de control de versiones
# 3. Usa variables de entorno en producción
# 4. Rota las claves periódicamente
# 5. Mantén secretos en bóveda (Vault, 1Password, etc)
# 6. Registra accesos a secretos en auditoría
# ====================================================
