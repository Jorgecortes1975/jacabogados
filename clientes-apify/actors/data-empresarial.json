{
  "actor": {
    "id": "data-empresarial",
    "nombre": "Extractor Datos Empresariales",
    "descripcion": "Extrae información de empresas de registros públicos colombianos (Cámara de Comercio, Superintendencia, DIAN)",
    "version": "1.0",
    "apifyActorId": "~pendiente-registro-apify~",
    "apifyTaskId": "~pendiente~",
    "repositorio": "~interno-jac~",
    "tipo": "data-extraction",
    "estado": "documentacion-completa"
  },
  "entrada": {
    "schema": {
      "type": "object",
      "required": [
        "ubicacion"
      ],
      "properties": {
        "ubicacion": {
          "type": "string",
          "description": "Ciudad o departamento donde buscar (ej: Medellín, Bogotá, Antioquia)",
          "example": "Medellín"
        },
        "empleados_minimo": {
          "type": "integer",
          "default": 50,
          "description": "Número mínimo de empleados de la empresa",
          "minimum": 1,
          "maximum": 10000
        },
        "empleados_maximo": {
          "type": "integer",
          "default": 500,
          "description": "Número máximo de empleados de la empresa",
          "minimum": 1,
          "maximum": 10000
        },
        "sectores": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Lista de sectores económicos a buscar (ej: Servicios, Manufactura, Retail). Vacío = todos",
          "example": [
            "Servicios Profesionales",
            "Retail",
            "Manufactura"
          ]
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Palabras clave en nombre o descripción de empresa (ej: nómina, payroll, RRHH)",
          "example": [
            "nómina",
            "payroll",
            "recursos humanos"
          ]
        },
        "estado_empresa": {
          "type": "string",
          "default": "activa",
          "description": "Estado de la empresa: activa, inactiva, cancelada",
          "enum": [
            "activa",
            "inactiva",
            "cancelada",
            "cualquiera"
          ]
        },
        "maximo_resultados": {
          "type": "integer",
          "default": 100,
          "description": "Número máximo de empresas a retornar",
          "minimum": 1,
          "maximum": 1000
        },
        "ordenar_por": {
          "type": "string",
          "default": "empleados_desc",
          "description": "Ordenamiento de resultados",
          "enum": [
            "empleados_desc",
            "empleados_asc",
            "nombre_asc",
            "reciente"
          ]
        },
        "fuentes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Cámara de Comercio",
            "Superintendencia",
            "DIAN"
          ],
          "description": "Fuentes de datos a consultar",
          "enum": [
            "Cámara de Comercio",
            "Superintendencia",
            "DIAN"
          ]
        }
      }
    },
    "ejemplo": {
      "ubicacion": "Medellín",
      "empleados_minimo": 50,
      "empleados_maximo": 500,
      "sectores": [
        "Servicios Profesionales",
        "Retail"
      ],
      "keywords": [
        "nómina",
        "payroll"
      ],
      "estado_empresa": "activa",
      "maximo_resultados": 50,
      "ordenar_por": "empleados_desc",
      "fuentes": [
        "Cámara de Comercio",
        "Superintendencia"
      ]
    }
  },
  "salida": {
    "formato": "json",
    "descripcion": "Lista de empresas con información de registros públicos",
    "schema": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "razonSocial": {
            "type": "string",
            "description": "Nombre legal de la empresa"
          },
          "nit": {
            "type": "string",
            "description": "Número de Identificación Tributaria"
          },
          "digito": {
            "type": "string",
            "description": "Dígito verificador del NIT"
          },
          "actividad_economica": {
            "type": "string",
            "description": "Código CIIU y descripción"
          },
          "sector": {
            "type": "string",
            "description": "Sector económico clasificado"
          },
          "empleados_reportados": {
            "type": "integer",
            "description": "Número de empleados en último reporte"
          },
          "ingresos_anuales": {
            "type": "string",
            "description": "Ingresos anuales reportados (en millones de pesos)"
          },
          "estado": {
            "type": "string",
            "description": "Estado de la empresa (activa, inactiva, cancelada)"
          },
          "fecha_constitucion": {
            "type": "string",
            "format": "date",
            "description": "Fecha de constitución de la empresa"
          },
          "ubicacion": {
            "type": "object",
            "properties": {
              "ciudad": {
                "type": "string",
                "description": "Ciudad de ubicación"
              },
              "departamento": {
                "type": "string",
                "description": "Departamento/región"
              },
              "direccion": {
                "type": "string",
                "description": "Dirección registrada"
              }
            }
          },
          "contacto": {
            "type": "object",
            "properties": {
              "telefono": {
                "type": "string",
                "description": "Teléfono principal de la empresa"
              },
              "correo": {
                "type": "string",
                "description": "Email registrado"
              },
              "sitio_web": {
                "type": "string",
                "description": "Sitio web si está disponible"
              }
            }
          },
          "propietarios": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nombre": {
                  "type": "string"
                },
                "cedula": {
                  "type": "string"
                },
                "porcentaje": {
                  "type": "number"
                }
              }
            },
            "description": "Accionistas/propietarios principales"
          },
          "representante_legal": {
            "type": "object",
            "properties": {
              "nombre": {
                "type": "string"
              },
              "cedula": {
                "type": "string"
              },
              "cargo": {
                "type": "string"
              }
            },
            "description": "Representante legal de la empresa"
          },
          "fuente": {
            "type": "string",
            "description": "Fuente de origen del dato",
            "enum": [
              "Cámara de Comercio",
              "Superintendencia",
              "DIAN"
            ]
          },
          "extraido_en": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha/hora de extracción"
          }
        }
      }
    },
    "ejemploItem": {
      "razonSocial": "Empresa Medellín S.A.S.",
      "nit": "900123456",
      "digito": "7",
      "actividad_economica": "6201 - Servicios de Consultoría",
      "sector": "Servicios Profesionales",
      "empleados_reportados": 75,
      "ingresos_anuales": "2500",
      "estado": "activa",
      "fecha_constitucion": "2015-03-15",
      "ubicacion": {
        "ciudad": "Medellín",
        "departamento": "Antioquia",
        "direccion": "Cra 43A No 10-50, Medellín"
      },
      "contacto": {
        "telefono": "+57 4 3123456",
        "correo": "contacto@empresa.com.co",
        "sitio_web": "https://www.empresa.com.co"
      },
      "propietarios": [
        {
          "nombre": "Juan Pérez García",
          "cedula": "1234567890",
          "porcentaje": 51
        }
      ],
      "representante_legal": {
        "nombre": "María López Rodríguez",
        "cedula": "9876543210",
        "cargo": "Gerente General"
      },
      "fuente": "Cámara de Comercio",
      "extraido_en": "2026-09-21T02:30:00Z"
    }
  },
  "configuracion": {
    "timeout": 1800000,
    "retries": 3,
    "buildTag": "latest",
    "memoryMbytes": 1024,
    "maxPagesPerRun": 50,
    "delayCacheMs": 0
  },
  "capacidades": {
    "buscarPorUbicacion": {
      "enabled": true,
      "descripcion": "Busca empresas por ciudad o departamento"
    },
    "filtrarPorTamanio": {
      "enabled": true,
      "descripcion": "Filtra por rango de empleados"
    },
    "filtrarPorSector": {
      "enabled": true,
      "descripcion": "Filtra por sector económico"
    },
    "buscarPorKeyword": {
      "enabled": true,
      "descripcion": "Busca por palabras clave en nombre/descripción"
    },
    "obtenerContacto": {
      "enabled": true,
      "descripcion": "Extrae teléfono, email, sitio web"
    },
    "obtenerPropietarios": {
      "enabled": true,
      "descripcion": "Obtiene información de accionistas"
    },
    "obtenerRepresentante": {
      "enabled": true,
      "descripcion": "Obtiene representante legal"
    }
  },
  "casos_uso": [
    {
      "titulo": "Búsqueda de Clientes Potenciales por Ubicación y Tamaño",
